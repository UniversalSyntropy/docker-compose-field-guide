# Secrets — never commit passwords or tokens
secrets/

# Environment — contains local-specific config; use .env.example as template
.env
.env.local
.env.*.local

# Persistent data from local runs (quickstart, etc.)
quickstart/data/

# Backup files
*.bak
*.backup
*.orig
*.tmp

# UniversalSyntropy AI Brain — do not track in Git
# Prevents sync conflicts, data leaks, and bloated repos
UniversalSyntropy-Vault/
.obsidian/
*.sync-conflict-*
.stfolder/

# OS files
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
